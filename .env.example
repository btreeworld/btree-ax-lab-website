# 사이트 기본 정보 (마스터 문서 27장)
NEXT_PUBLIC_SITE_URL=https://example.com

# 문의 폼 이메일 — Resend 호환 API. 미설정 시 개발 환경에서는 폼이 동작하되 메일 전송을 건너뛰고,
# 프로덕션(NODE_ENV=production)에서는 설정 누락으로 간주해 문의 접수 자체를 실패 처리합니다.
CONTACT_TO_EMAIL=contact@example.com
CONTACT_FROM_EMAIL=website@example.com
EMAIL_API_KEY=

# Cloudflare Turnstile — 문의 폼 봇 방지 2차 방어선(1차는 honeypot). 사이트키가 없으면
# 위젯을 렌더링하지 않고 서버도 검증을 건너뜁니다. 둘 다 Cloudflare 대시보드에서 발급합니다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 분석 (미설정 시 GA4 스크립트를 로드하지 않습니다)
NEXT_PUBLIC_GA_ID=

# 푸터·문의 페이지에 노출되는 대표 이메일. 대표 전화는 노출하지 않기로 결정해 이 파일에서 제외했습니다.
NEXT_PUBLIC_COMPANY_EMAIL=

# 스테이징 색인 차단 (true 일 때 noindex + robots disallow)
SITE_NOINDEX=false
