# 사이트 기본 정보 (마스터 문서 27장)
NEXT_PUBLIC_SITE_URL=https://example.com

# 문의 폼 이메일 (미설정 시 폼은 동작하되 메일 전송을 건너뜁니다)
CONTACT_TO_EMAIL=contact@example.com
CONTACT_FROM_EMAIL=website@example.com
EMAIL_API_KEY=

# 분석 (미설정 시 GA4 스크립트를 로드하지 않습니다)
NEXT_PUBLIC_GA_ID=

# 푸터·문의 페이지에 노출되는 대표 연락처
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=

# 스테이징 색인 차단 (true 일 때 noindex + robots disallow)
SITE_NOINDEX=false
